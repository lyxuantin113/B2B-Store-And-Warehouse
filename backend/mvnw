set -euf

# Auto-detect Homebrew OpenJDK on macOS if JAVA_HOME is not set
if [ -z "${JAVA_HOME:-}" ] && [ -d "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home" ]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
elif [ -z "${JAVA_HOME:-}" ] && [ -d "/opt/homebrew/opt/openjdk" ]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk"
fi

WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_VERSION="3.9.9"
MAVEN_HOME_DIR="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="${MAVEN_HOME_DIR}/apache-maven-${MAVEN_VERSION}/bin/mvn"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"

if [ ! -x "${MAVEN_BIN}" ]; then
  echo "Downloading Apache Maven ${MAVEN_VERSION}..."
  mkdir -p "${MAVEN_HOME_DIR}"
  curl -fsSL "${DIST_URL}" | tar -xz -C "${MAVEN_HOME_DIR}"
fi

exec "${MAVEN_BIN}" "$@"
