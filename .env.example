# ==============================================================================
# B2B Wholesale & Sample Management Platform - Environment Variables Template
# Copy this file to .env and customize for your local or production environment
# ==============================================================================

# --- Server & Environment ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL 16 + PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=b2b_warehouse
POSTGRES_USER=b2b_user
POSTGRES_PASSWORD=b2b_secret_2026

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2026

# --- Apache Kafka (KRaft Mode) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- MinIO (S3-Compatible Storage for B2B Licenses & Product Images) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=b2b_minio_admin
MINIO_ROOT_PASSWORD=b2b_minio_secret_2026
MINIO_BUCKET_LICENSES=b2b-licenses
MINIO_BUCKET_PRODUCTS=b2b-products

# --- Security & Cryptography ---
# 32-byte (256-bit) Base64-encoded master key for AES-256-GCM encryption of system_configs
APP_SECURITY_AES_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 64-byte Base64-encoded secret for JWT token signing (HS512 / RS256 fallback in dev)
APP_SECURITY_JWT_SECRET=YjJiLXdhcmVob3VzZS1zdXBlci1zZWNyZXQtand0LWtleS1mb3ItZGV2ZWxvcG1lbnQtb25seS0yMDI2LWhpZ2gtdHJhZmZpYw==
APP_SECURITY_JWT_ACCESS_EXPIRATION_SECONDS=900
APP_SECURITY_JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- Payment Gateways (Vietnam) ---
VNPAY_TMN_CODE=DEMO_VNPAY_TMN
VNPAY_HASH_SECRET=DEMO_VNPAY_HASH_SECRET_KEY_2026
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/b2b/checkout/vnpay-return

MOMO_PARTNER_CODE=DEMO_MOMO_PARTNER
MOMO_ACCESS_KEY=DEMO_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=DEMO_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

VIETQR_CLIENT_ID=DEMO_VIETQR_CLIENT_ID
VIETQR_API_KEY=DEMO_VIETQR_API_KEY
VIETQR_CHECKSUM_KEY=DEMO_VIETQR_CHECKSUM_KEY

# --- Shipping & Logistics Providers (Vietnam) ---
GHN_API_TOKEN=DEMO_GHN_TOKEN
GHN_SHOP_ID=123456
GHTK_API_TOKEN=DEMO_GHTK_TOKEN
AHAMOVE_API_KEY=DEMO_AHAMOVE_KEY

# --- Google Maps Platform (Store Locator & Address Autocomplete) ---
GOOGLE_MAPS_API_KEY=DEMO_GOOGLE_MAPS_SERVER_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=DEMO_GOOGLE_MAPS_BROWSER_KEY
